<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Carried by the app bundle at Contents/Library/LaunchDaemons/. SMAppService registers it when a
  move needs it (an administrator allows it in System Settings, Login Items). RunAtLoad makes
  launchd start it once when it is registered, and again at each start-up of the Mac while it
  stays registered; KeepAlive is off, so it is never restarted after it exits. Started with no
  arguments, the helper is the launch daemon: it serves the first move an administrator approves
  for (Security Design part C) and ends, or ends after ten minutes with none; the app unregisters
  it when the move ends. BundleProgram is inside the signed bundle.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.creoleailabs.pctwin.helper</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/pctwin-helper</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.creoleailabs.pctwin</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<false/>
</dict>
</plist>
