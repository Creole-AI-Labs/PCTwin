{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window's screens: they may call the app's own commands (window size by name, tray labels, pairing, the move), each granted by name and taking typed arguments only; listen to the app's own events (pairing and move updates); and open our own site in the browser. Nothing else.",
  "windows": ["main"],
  "permissions": [
    "allow-set-window-mode",
    "allow-set-tray-labels",
    "allow-pairing-old-start",
    "allow-pairing-old-pick",
    "allow-pairing-old-decline",
    "allow-pairing-old-shuffle",
    "allow-pairing-old-rename",
    "allow-pairing-old-start-again",
    "allow-pairing-heads-up",
    "allow-pairing-stop",
    "allow-pairing-new-search",
    "allow-pairing-new-connect",
    "allow-move-begin",
    "allow-move-approve",
    "allow-move-pause",
    "allow-move-resume",
    "allow-move-stop",
    "allow-move-report",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://getpctwin.com/*" }]
    }
  ]
}
