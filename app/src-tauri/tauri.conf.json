{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PCTwin",
  "version": "0.1.0",
  "identifier": "com.creoleailabs.pctwin",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PCTwin",
        "width": 480,
        "height": 620,
        "minWidth": 360,
        "minHeight": 240,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true,
      "capabilities": [
        "default"
      ]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwMzExQ0UyNkYzQzlFMjAKUldRZ25qeHY0aHd4UUt3YzBFS2hwUCtxWXlUSnZPcE10UVRJRi84alRmNVplcEJtazhlSHNmaVIK",
      "endpoints": ["https://pctwin-test.pages.dev/update/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "hardenedRuntime": true
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/header.bmp",
        "sidebarImage": "windows/sidebar.bmp",
        "uninstallerIcon": "icons/icon.ico",
        "uninstallerHeaderImage": "windows/header.bmp",
        "languages": ["English", "French", "Spanish", "Portuguese", "PortugueseBR", "Arabic", "SimpChinese"]
      }
    }
  }
}
